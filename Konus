-- Konus Screamer Lite
-- Авто-скример на ближайшего игрока

local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local WS = workspace
local RunService = game:GetService("RunService")
local Cam = WS.CurrentCamera

-- Найти ближайшего игрока
local target = nil
local minDist = math.huge

for _, p in pairs(Players:GetPlayers()) do
    if p ~= LP and p.Character and p.Character:FindFirstChild("Head") then
        local dist = (LP.Character.Head.Position - p.Character.Head.Position).Magnitude
        if dist < minDist then
            minDist = dist
            target = p
        end
    end
end

if not target then
    game:GetService("StarterGui"):SetCore("SendNotification", {Title="Скример", Text="Нет игроков рядом!", Duration=3})
    return
end

-- Скример
local pg = target:FindFirstChild("PlayerGui")
if pg then
    local sg = Instance.new("ScreenGui", pg)
    
    local bg = Instance.new("Frame", sg)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.new(0,0,0)
    
    local face = Instance.new("ImageLabel", bg)
    face.Size = UDim2.new(0.8,0,0.8,0)
    face.Position = UDim2.new(0.1,0,0.1,0)
    face.Image = "rbxassetid://17428653442"
    face.BackgroundTransparency = 1
    
    local txt = Instance.new("TextLabel", bg)
    txt.Size = UDim2.new(1,0,0.1,0)
    txt.Position = UDim2.new(0,0,0,0)
    txt.Text = "👁 Я ТЕБЯ ВИЖУ 👁"
    txt.TextColor3 = Color3.new(1,0,0)
    txt.Font = Enum.Font.GothamBlack
    txt.TextSize = 30
    txt.BackgroundTransparency = 1
    
    -- Эффект
    for i = 0, 1, 0.02 do
        bg.BackgroundTransparency = 1 - i
        RunService.RenderStepped:Wait()
    end
    
    wait(2)
    sg:Destroy()
end

-- Тряска камеры у нас
local orig = Cam.CFrame
for _ = 1, 20 do
    Cam.CFrame = orig * CFrame.new(math.random(-2,2), math.random(-2,2), 0)
    RunService.RenderStepped:Wait()
end
Cam.CFrame = orig
