local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local SG = game:GetService("StarterGui")
local WS = workspace
local RunService = game:GetService("RunService")

-- Уведомление
function Notify(text)
    pcall(function()
        SG:SetCore("SendNotification", {
            Title = "Konus Screamer",
            Text = text,
            Duration = 3
        })
    end)
end

-- Функция поиска игрока
function FindPlayer(name)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Name:lower():find(name:lower()) then
            return p
        end
    end
    return nil
end

-- Функция скримера для конкретного игрока
function ScreamerPlayer(target)
    -- Спавним скример в игрока
    local char = target.Character
    if not char then
        Notify("Игрок не загружен!")
        return
    end
    
    -- Создаём страшный GUI в PlayerGui игрока
    local plrGui = target:FindFirstChild("PlayerGui")
    if not plrGui then
        Notify("PlayerGui не найден!")
        return
    end
    
    -- Скример GUI
    local scr = Instance.new("ScreenGui")
    scr.Name = "ScreamerGUI"
    scr.Parent = plrGui
    
    -- Чёрный фон
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.Parent = scr
    
    -- Красная вспышка
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    flash.BackgroundTransparency = 0.7
    flash.Parent = scr
    
    -- Страшное лицо
    local face = Instance.new("ImageLabel")
    face.Size = UDim2.new(0.7, 0, 0.7, 0)
    face.Position = UDim2.new(0.15, 0, 0.15, 0)
    face.Image = "rbxassetid://17428653442"
    face.BackgroundTransparency = 1
    face.Parent = scr
    
    -- Текст
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 0.1, 0)
    txt.Position = UDim2.new(0, 0, 0.05, 0)
    txt.BackgroundTransparency = 1
    txt.Text = "👁 Я ВИЖУ ТЕБЯ 👁"
    txt.TextColor3 = Color3.fromRGB(255, 0, 0)
    txt.Font = Enum.Font.GothamBlack
    txt.TextSize = 40
    txt.Parent = scr
    
    -- Эффект появления
    for i = 0, 1, 0.03 do
        bg.BackgroundTransparency = 1 - i
        flash.BackgroundTransparency = 0.7 - (i * 0.3)
        RunService.RenderStepped:Wait()
    end
    
    -- Тряска камеры (если мы рядом)
    if char:FindFirstChild("HumanoidRootPart") and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        local dist = (LP.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude
        if dist < 100 then
            local origCF = workspace.CurrentCamera.CFrame
            spawn(function()
                for _ = 1, 20 do
                    pcall(function()
                        workspace.CurrentCamera.CFrame = origCF * CFrame.new(
                            math.random(-3, 3),
                            math.random(-3, 3),
                            math.random(-1, 1)
                        )
                    end)
                    RunService.RenderStepped:Wait()
                end
                pcall(function() workspace.CurrentCamera.CFrame = origCF end)
            end)
        end
    end
    
    -- Звук (если есть)
    spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://9116487514" -- страшный звук
        sound.Volume = 10
        sound.Parent = char
        sound:Play()
    end)
    
    -- Убираем через 3 секунды
    wait(3)
    pcall(function() scr:Destroy() end)
    
    Notify("Скример отправлен: " .. target.Name)
end

