                        local tl=Instance.new("TextLabel",bg);tl.Size=UDim2.new(1,0,1,0);tl.BackgroundTransparency=1;tl.Text=p.Name;tl.TextColor3=Color3.fromRGB(255,0,0);tl.Font=Enum.Font.GothamBlack;tl.TextSize=20
                    end
                end
            end
            RunService.RenderStepped:Wait()
        end end)
        Notify("ESP ВКЛ")
    else
        for _,p in pairs(Players:GetPlayers())do
            if p.Character and p.Character:FindFirstChild("Head")then
                local h=p.Character.Head;local l=h:FindFirstChild("EspLabel");if l then l:Destroy()end
            end
        end
        Notify("ESP ВЫКЛ")
    end
end

