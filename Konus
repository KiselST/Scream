local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local SG = game:GetService("StarterGui")

function Notify(text)
    pcall(function()
        SG:SetCore("SendNotification", {Title = "Konus Screamer", Text = text, Duration = 3})
    end)
end

function FindPlayer(name)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Name:lower():find(name:lower()) then
            return p
        end
    end
    return nil
end

function ScreamerPlayer(target)
    local char = target.Character
    if not char then Notify("Игрок не загружен!"); return end
    
    local head = char:FindFirstChild("Head")
    if not head then Notify("Голова не найдена!"); return end
    
    -- Способ 1: Прямо в Head игрока
    local sg = Instance.new("SurfaceGui")
    sg.Parent = head
    sg.Face = Enum.NormalId.Front
    sg.AdornWhenChildIsInWorkspace = true
    sg.CanBeRemoved = false
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(5, 0, 5, 0)
    frame.Position = UDim2.new(-2, 0, -2, 0)
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.Parent = sg
    
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0.8, 0, 0.8, 0)
    img.Position = UDim2.new(0.1, 0, 0.1, 0)
    img.Image = "rbxassetid://17428653442"
    img.BackgroundTransparency = 1
    img.Parent = frame
    
    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 0.2, 0)
    txt.Position = UDim2.new(0, 0, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = "👁 Я ВИЖУ ТЕБЯ 👁"
    txt.TextColor3 = Color3.fromRGB(255, 0, 0)
    txt.Font = Enum.Font.GothamBlack
    txt.TextSize = 60
    txt.Parent = frame
    
    -- Способ 2: PlayerGui (если работает)
    local pg = target:FindFirstChild("PlayerGui")
    if pg then
        local screen = Instance.new("ScreenGui", pg)
        screen.IgnoreGuiInset = true
        
        local bg = Instance.new("Frame", screen)
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        
        local face = Instance.new("ImageLabel", bg)
        face.Size = UDim2.new(0.7, 0, 0.7, 0)
        face.Position = UDim2.new(0.15, 0, 0.15, 0)
        face.Image = "rbxassetid://17428653442"
        face.BackgroundTransparency = 1
        
        local t = Instance.new("TextLabel", bg)
        t.Size = UDim2.new(1, 0, 0.1, 0)
        t.Position = UDim2.new(0, 0, 0.05, 0)
        t.BackgroundTransparency = 1
        t.Text = "👁 Я ТЕБЯ ВИЖУ 👁"
        t.TextColor3 = Color3.fromRGB(255, 0, 0)
        t.Font = Enum.Font.GothamBlack
        t.TextSize = 40
        
        wait(3)
        pcall(function() screen:Destroy() end)
    end
    
    -- Способ 3: BillboardGui над головой
    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(10, 0, 10, 0)
    bill.Parent = head
    bill.AlwaysOnTop = true
    
    local bframe = Instance.new("Frame", bill)
    bframe.Size = UDim2.new(1, 0, 1, 0)
    bframe.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    
    local bimg = Instance.new("ImageLabel", bframe)
    bimg.Size = UDim2.new(1, 0, 1, 0)
    bimg.Image = "rbxassetid://17428653442"
    bimg.BackgroundTransparency = 1
    
    -- Звук
    local sound = Instance.new("Sound", head)
    sound.SoundId = "rbxassetid://9116487514"
    sound.Volume = 10
    sound:Play()
    
    wait(3)
    pcall(function() sg:Destroy() end)
    pcall(function() bill:Destroy() end)
    pcall(function() sound:Destroy() end)
    
    Notify("✅ Скример отправлен: " .. target.Name)
end

