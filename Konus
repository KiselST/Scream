local Vehicles={"Bugatti","Lamborghini","Ferrari","Tesla","Police Car","Helicopter","Monster Truck","Tank","Jeep","Quad"}

function SpawnVehicle(vh)
    local f=nil
    for _,fd in pairs({WS,game:GetService("ReplicatedStorage")})do
        for _,fn in pairs({"Vehicles","Cars"})do
            local ff=fd:FindFirstChild(fn);if ff then for _,m in pairs(ff:GetChildren())do if m:IsA("Model")and m.Name:lower():find(vh:lower())then f=m;break end end end;if f then break end
        end;if f then break end
    end
    if f and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")then
        local cl=f:Clone();cl:MakeJoints();cl:SetPrimaryPartCFrame(LP.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,-8));cl.Parent=WS;Notify(vh.." заспавнен!")
    else Notify("Не найдено: "..vh)end
end

