local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local SG = game:GetService("StarterGui")
local WS = workspace

function Notify(text)
    pcall(function()
        SG:SetCore("SendNotification", {Title = "Konus Screamer", Text = text, Duration = 3})
    end)
end

function FindPlayer(name)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Name:lower():find(name:lower()) then
            return p
        end
    end
    return nil
end

function ScreamerPlayer(target)
    local char = target.Character
    if not char then Notify("❌ Игрок не загружен!"); return end
    
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not head or not root then Notify("❌ Части тела не найдены!"); return end
    
    -- ОГОНЬ на голове (видят ВСЕ!)
    local fire = Instance.new("Fire")
    fire.Size = 30
    fire.Heat = 100
    fire.Parent = head
    
    -- ДЫМ вокруг игрока (видят ВСЕ!)
    local smoke = Instance.new("Smoke")
    smoke.Size = 50
    smoke.RiseVelocity = 10
    smoke.Parent = root
    
    -- ИСКРЫ (видят ВСЕ!)
    local sparkles = Instance.new("Sparkles")
    sparkles.SparkleColor = Color3.fromRGB(255, 0, 0)
    sparkles.Parent = head
    
    -- ЗВУК (слышат ВСЕ рядом!)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://9116487514"
    sound.Volume = 10
    sound.Parent = head
    sound:Play()
    
    -- ТЕЛЕПОРТ игрока вверх-вниз (видят ВСЕ!)
    spawn(function()
        local origPos = root.CFrame
        for i = 1, 10 do
            pcall(function()
                root.CFrame = origPos * CFrame.new(0, math.random(10, 30), 0)
            end)
            wait(0.3)
            pcall(function()
                root.CFrame = origPos
            end)
            wait(0.3)
        end
        pcall(function() root.CFrame = origPos end)
    end)
    
    -- Убираем эффекты через 8 секунд
    wait(8)
    pcall(function() fire:Destroy() end)
    pcall(function() smoke:Destroy() end)
    pcall(function() sparkles:Destroy() end)
    pcall(function() sound:Destroy() end)
    
    Notify("✅ Скример отправлен: " .. target.Name)
end

