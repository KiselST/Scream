function Notify(t)
    pcall(function()
        SG:SetCore("SendNotification", {Title="Konus HUB", Text=t, Duration=3})
    end)
end

function FindPlayer(n)
    for _,p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Name:lower():find(n:lower()) then return p end
    end
    return nil
end

-- ===== ФУНКЦИИ СКРИМЕРА =====
function ScreamerFire(target)
    local char = target.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not head or not root then return end
    
    -- Огонь (видят все)
    local fire = Instance.new("Fire")
    fire.Size = 30
    fire.Heat = 100
    fire.Parent = head
    
    -- Дым (видят все)
    local smoke = Instance.new("Smoke")
    smoke.Size = 50
    smoke.RiseVelocity = 15
    smoke.Parent = root
    
    -- Искры (видят все)
    local spark = Instance.new("Sparkles")
    spark.SparkleColor = Color3.fromRGB(255,0,0)
    spark.Parent = head
    
    -- Звук (слышат рядом)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://9116487514"
    sound.Volume = 10
    sound.Parent = head
    sound:Play()
    
    -- Тряска (видят все)
    spawn(function()
        local orig = root.CFrame
        for i=1,15 do
            pcall(function()
                root.CFrame = orig * CFrame.new(math.random(-5,5), math.random(5,20), math.random(-5,5))
            end)
            wait(0.2)
        end
        pcall(function() root.CFrame = orig end)
    end)
    
    wait(8)
    pcall(function() fire:Destroy() end)
    pcall(function() smoke:Destroy() end)
    pcall(function() spark:Destroy() end)
    pcall(function() sound:Destroy() end)
    
    Notify("Скример на "..target.Name.." отправлен!")
end

