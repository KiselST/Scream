function TeleportTo(loc)
    local f=nil
    for _,v in pairs(WS:GetDescendants())do
        if v:IsA("Model")and v.Name:lower():find(loc:lower())then
            local pp=v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart");if pp then f=pp;break end
        end
    end
    if f and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")then
        LP.Character.HumanoidRootPart.CFrame=f.CFrame*CFrame.new(0,3,0);Notify("ТП: "..loc)
    else Notify("Не найдено: "..loc)end
end

