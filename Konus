function Notify(t,d)
    d=d or 3
    pcall(function() SG:SetCore("SendNotification",{Title="Konus HUB",Text=t,Duration=d}) end)
end

function FindPlayer(n)
    for _,p in pairs(Players:GetPlayers()) do
        if p~=LP and p.Name:lower():find(n:lower()) then return p end
    end
    return nil
end

-- ===== СКРИМЕРЫ =====
function ScreamerFire(target)
    local c=target.Character;if not c then return end
    local h=c:FindFirstChild("Head");local r=c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    local f=Instance.new("Fire",h);f.Size=30;f.Heat=100
    local s=Instance.new("Smoke",r);s.Size=50;s.RiseVelocity=15
    local sp=Instance.new("Sparkles",h);sp.SparkleColor=Color3.fromRGB(255,0,0)
    local sd=Instance.new("Sound",h);sd.SoundId="rbxassetid://9116487514";sd.Volume=10;sd:Play()
    spawn(function()local o=r.CFrame;for i=1,15 do pcall(function()r.CFrame=o*CFrame.new(math.random(-5,5),math.random(5,20),math.random(-5,5))end)wait(0.2)end;pcall(function()r.CFrame=o end)end)
    wait(8);pcall(function()f:Destroy()s:Destroy()sp:Destroy()sd:Destroy()end)
    Notify("Скример на "..target.Name)
end

function ScreamerGUI(target)
    local pg=target:FindFirstChild("PlayerGui");if not pg then return end
    local sg=Instance.new("ScreenGui",pg);sg.IgnoreGuiInset=true
    local bg=Instance.new("Frame",sg);bg.Size=UDim2.new(1,0,1,0);bg.BackgroundColor3=Color3.fromRGB(0,0,0)
    local img=Instance.new("ImageLabel",bg);img.Size=UDim2.new(0.8,0,0.8,0);img.Position=UDim2.new(0.1,0,0.1,0);img.Image="rbxassetid://17428653442";img.BackgroundTransparency=1
    local txt=Instance.new("TextLabel",bg);txt.Size=UDim2.new(1,0,0.1,0);txt.Position=UDim2.new(0,0,0.05,0);txt.BackgroundTransparency=1;txt.Text="👁 Я ВИЖУ ТЕБЯ 👁";txt.TextColor3=Color3.fromRGB(255,0,0);txt.Font=Enum.Font.GothamBlack;txt.TextSize=40
    for i=0,1,0.02 do bg.BackgroundTransparency=1-i;RunService.RenderStepped:Wait()end
    wait(3);pcall(function()sg:Destroy()end)
end

-- ===== ТРОЛЛИНГ =====
function FlingPlayer(target)
    local c=target.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
    r.Velocity=Vector3.new(math.random(-500,500),500,math.random(-500,500));r.RotVelocity=Vector3.new(math.random(-100,100),math.random(-100,100),math.random(-100,100))
    Notify(target.Name.." улетел!")
end

function CagePlayer(target)
    local c=target.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
    local p=r.Position
    for x=-2,2 do for y=0,4 do for z=-2,2 do if math.abs(x)==2 or math.abs(y)==4 or math.abs(z)==2 or y==0 then
    local pr=Instance.new("Part",WS);pr.Size=Vector3.new(2,2,2);pr.Position=p+Vector3.new(x*2,y*2,z*2);pr.Anchored=true;pr.BrickColor=BrickColor.random()
    end end end end
    Notify(target.Name.." в клетке!")
end

function CrashPlayer(target)
    local c=target.Character;if not c then return end
    for _,v in pairs(c:GetChildren()) do if v:IsA("BasePart")and v.Name~="HumanoidRootPart"then pcall(function()v:Destroy()end)end end
    local h=c:FindFirstChild("Humanoid");if h then pcall(function()h:Destroy()end)end
    Notify(target.Name.." уничтожен!")
end

function FreezePlayer(target)
    local c=target.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
    r.Anchored=not r.Anchored;Notify(target.Name..(r.Anchored and" заморожен!"or" разморожен!"))
end

function StripPlayer(target)
    local c=target.Character;if not c then return end
    for _,v in pairs(c:GetChildren())do if v:IsA("Shirt")or v:IsA("Pants")or v:IsA("Accessory")or v:IsA("Hat")then v:Destroy()end end
    Notify(target.Name.." раздет!")
end

-- ===== АДМИН =====
function KickPlayer(target)
    pcall(function()target:Kick("[Konus HUB] Кик")end)
    Notify(target.Name.." кикнут!")
end

function BanPlayer(target)
    local c=target.Character;if c then for _,v in pairs(c:GetChildren())do if v:IsA("BasePart")then v:Destroy()end end end
    pcall(function()target:Kick("[Konus HUB] Бан")end)
    Notify(target.Name.." забанен!")
end

function TpToMe(target)
    local c=target.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
    local my=LP.Character;if not my then return end;local mr=my:FindFirstChild("HumanoidRootPart");if not mr then return end
    r.CFrame=mr.CFrame*CFrame.new(2,0,0);Notify(target.Name.." телепортирован!")
end

function ExplodePlayer(target)
    local c=target.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
    local ex=Instance.new("Explosion",WS);ex.Position=r.Position;ex.BlastRadius=15;ex.BlastPressure=1e6
    Notify(target.Name.." взорван!")
end

-- ===== ИГРОК =====
local flyOn=false
function FlyToggle()
    flyOn=not flyOn
    if flyOn then
        local c=LP.Character;if not c then return end;local r=c:FindFirstChild("HumanoidRootPart");if not r then return end
        c.Humanoid.PlatformStand=true
        local bg=Instance.new("BodyGyro",r);bg.P=9e4;bg.MaxTorque=Vector3.new(9e9,9e9,9e9)
        local bv=Instance.new("BodyVelocity",r);bv.MaxForce=Vector3.new(9e9,9e9,9e9)
        spawn(function()while flyOn and r do bg.CFrame=Camera.CFrame;local s=50;bv.Velocity=Vector3.new(0,0,0)
        if UIS:IsKeyDown(Enum.KeyCode.W)then bv.Velocity+=Camera.CFrame.LookVector*s end
        if UIS:IsKeyDown(Enum.KeyCode.S)then bv.Velocity-=Camera.CFrame.LookVector*s end
        if UIS:IsKeyDown(Enum.KeyCode.A)then bv.Velocity-=Camera.CFrame.RightVector*s end
        if UIS:IsKeyDown(Enum.KeyCode.D)then bv.Velocity+=Camera.CFrame.RightVector*s end
        if UIS:IsKeyDown(Enum.KeyCode.Space)then bv.Velocity+=Vector3.new(0,s,0)end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)then bv.Velocity-=Vector3.new(0,s,0)end
        RunService.RenderStepped:Wait()end end)
        Notify("Полёт ВКЛ")
    else
        local c=LP.Character;if c then c.Humanoid.PlatformStand=false;local r=c:FindFirstChild("HumanoidRootPart")
        if r then for _,v in pairs(r:GetChildren())do if v:IsA("BodyGyro")or v:IsA("BodyVelocity")then v:Destroy()end end end end
        Notify("Полёт ВЫКЛ")
    end
end

local noclipOn=false
function NoclipToggle()
    noclipOn=not noclipOn
    if noclipOn then
        spawn(function()while noclipOn do if LP.Character then for _,v in pairs(LP.Character:GetDescendants())do if v:IsA("BasePart")then v.CanCollide=false end end end;RunService.RenderStepped:Wait()end end)
        Notify("Ноклип ВКЛ")
    else
        if LP.Character then for _,v in pairs(LP.Character:GetDescendants())do if v:IsA("BasePart")then v.CanCollide=true end end end
        Notify("Ноклип ВЫКЛ")
    end
end

local invisOn=false
function InvisToggle()
    invisOn=not invisOn
    if invisOn then
        spawn(function()while invisOn do if LP.Character then for _,v in pairs(LP.Character:GetDescendants())do if v:IsA("BasePart")then v.Transparency=1 end end end;RunService.RenderStepped:Wait()end end)
        Notify("Невидимка ВКЛ")
    else
        if LP.Character then for _,v in pairs(LP.Character:GetDescendants())do if v:IsA("BasePart")then v.Transparency=0 end end end
        Notify("Невидимка ВЫКЛ")
    end
end

